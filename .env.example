# Copy to .env and replace every placeholder. Never commit .env.

# --- Django ---------------------------------------------------------------
DEBUG=False
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-production-secret
# Comma-separated host names/IPs users will type to reach the site.
ALLOWED_HOSTS=localhost,127.0.0.1
# Local timezone of the school. Date rules ("no future time logs", deadlines)
# use the local date, so this must match where users are.
TIME_ZONE=Asia/Singapore

# Set to True only once this is served behind a reverse proxy that terminates
# HTTPS. Leaving it False (the default) is required for local/plain-HTTP
# testing - setting it True without real HTTPS in front will lock you out.
BEHIND_HTTPS_PROXY=False

# --- PostgreSQL (shared by the db and web containers) ----------------------
POSTGRES_DB=ojt_management
POSTGRES_USER=ojt_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# --- Email (password-reset emails) ------------------------------------------
# Leave EMAIL_HOST empty to disable sending (reset emails will not arrive).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@your-school.edu
