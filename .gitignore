db.sqlite3
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Generated and collected assets
staticfiles/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# User uploads and generated backups (contain personal data and password hashes)
media/
backups/

# Excel reports downloaded from the app (Export Excel)
internship_postings_*.xlsx

# Python packaging / tooling output
*.egg-info/
.eggs/
.tox/
.nox/
pip-wheel-metadata/

# Editor and assistant tooling
.agents/
